# Secondary guard only. Cloudflare Pages resolves a matching static asset
# BEFORE consulting this file, so these rules do NOT block files that exist in
# the deployment — functions/_middleware.js is what actually refuses them.
# These remain as a fallback for paths that would otherwise 404.
#
# Format: <from> <to> <status>
/scripts/*            /404.html   404
/lib/*                /404.html   404
/data/*               /404.html   404
/node_modules/*       /404.html   404
/server.js            /404.html   404
/package.json         /404.html   404
/package-lock.json    /404.html   404
/supabase_schema.sql  /404.html   404
/.env                 /404.html   404
/.env.*               /404.html   404
