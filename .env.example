# Local Node server port
PORT=3000

# --- Supabase (server-side only; never expose these to the browser) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_secret_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# --- Admin portal ---
# Required. Login is disabled when this is unset.
ADMIN_PASSWORD=your_admin_password
# Optional. Signs admin session tokens on Cloudflare Pages.
# Defaults to ADMIN_PASSWORD; set it so rotating one doesn't force the other.
ADMIN_TOKEN_SECRET=a_long_random_string

# --- Contact form notifications ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
